# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Local tooling caches and test output
.vite/
.cache/
coverage/
.nyc_output/
.playwright-cli/
.superpowers/
playwright-report/
test-results/

# WebStorm / IntelliJ local project files
.idea/
*.iml

# Local environment files (keep documented templates)
.env
.env.*
!.env.production
!.env.example
!.env.*.example

# Runtime logs
*.log
npm-debug.log*

# Editor temporary files
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Native build output and local signing material
/.private/
/native/android/.gradle/
/native/android/local.properties
/native/android/**/build/
/native/ios/build/
/native/ios/DerivedData/
/native/ios/**/*.xcuserstate
/native/ios/**/xcuserdata/
*.jks
*.keystore
*.mobileprovision
*.p12
*.ipa
*.apk

# Build-time responsive WebP output; original media lives in media-source/<album>/.
# Derived album folders are ignored by their YYYY-MM-sequenceNN naming pattern.
/public/media/[0-9][0-9][0-9][0-9]-[0-9][0-9]-sequence*/
