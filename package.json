{
  "name": "wangleyou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate:photo-index": "tsx scripts/generate-photo-index.ts",
    "dev": "npm run generate:photo-index && vite --host 127.0.0.1",
    "validate:content": "npm run generate:photo-index && tsx scripts/validate-content.ts src/content/generated-photo-index.json public",
    "compress:photos": "tsx scripts/compress-photos.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run check:sdd -- --structure && npm run validate:content && npm run typecheck && npm run lint && npm test",
    "build": "npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check:sdd": "tsx scripts/sdd/cli.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-liquid-glass-svg": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
